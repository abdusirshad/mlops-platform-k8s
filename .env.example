# Copy to .env and adjust as needed:  cp .env.example .env
# (.env is git-ignored.) These mirror the env vars consumed by the services.

# MLflow tracking server URL.
#   - host:        http://localhost:5000
#   - in-compose:  http://mlflow:5000
MLFLOW_TRACKING_URI=http://localhost:5000

# Experiment + registered model name used by training and serving.
MLFLOW_EXPERIMENT=iris-classifier
MODEL_NAME=iris-classifier

# Which model to serve: a registry version number, an alias, or "latest".
MODEL_STAGE=latest

# Training accuracy gate — the model is not registered below this value.
ACCURACY_THRESHOLD=0.90
